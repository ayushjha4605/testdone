<?xml version="1.0" encoding="utf-8"?>
<!-- Standalone colored mark (transparent background) — "Rising Check" in brand
     gradient + gold star; overlays tiles like the Ultra box on any surface. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- check in brand gradient -->
    <path
        android:pathData="M29.9,52.9 L40.6,63.6 L59.8,39.7"
        android:strokeWidth="12.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="29.9"
                android:startY="63.6"
                android:endX="59.8"
                android:endY="39.7">
                <item android:offset="0" android:color="#FF4F46E5" />
                <item android:offset="1" android:color="#FFDB2777" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- subtle glow behind the star -->
    <path
        android:fillColor="#2EFBBF24"
        android:pathData="M52.4,29.3 A9.8,9.8 0 1 0 72,29.3 A9.8,9.8 0 1 0 52.4,29.3 Z" />

    <!-- gold achievement star -->
    <path android:pathData="M62.2,22.6 C63,26.26 65.22,28.5 68.9,29.3 C65.22,30.1 63,32.34 62.2,36 C61.4,32.34 59.18,30.1 55.5,29.3 C59.18,28.5 61.4,26.26 62.2,22.6 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="55.5"
                android:startY="22.6"
                android:endX="68.9"
                android:endY="36">
                <item android:offset="0" android:color="#FFFDE68A" />
                <item android:offset="0.55" android:color="#FFFBBF24" />
                <item android:offset="1" android:color="#FFF59E0B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- star hot core -->
    <path
        android:fillColor="#F2FFFFFF"
        android:pathData="M62.2,27 C62.5,28.44 63.06,29 64.5,29.3 C63.06,29.6 62.5,30.16 62.2,31.6 C61.9,30.16 61.34,29.6 59.9,29.3 C61.34,29 61.9,28.44 62.2,27 Z" />
</vector>
