<?xml version="1.0" encoding="utf-8"?>
<!-- TestDone launcher foreground — "Rising Check": bold glossy white checkmark
     rising toward the top-right, gold achievement star at its apex.
     108dp adaptive canvas; the mark stays inside the 66dp safe circle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- tight drop shadow: lifts the mark off the gradient -->
    <group android:translateY="2.6">
        <path
            android:pathData="M35,60.5 L47,72.5 L68.5,46.5"
            android:strokeColor="#591E1B4B"
            android:strokeWidth="14.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>

    <!-- main glossy stroke -->
    <path
        android:pathData="M35,60.5 L47,72.5 L68.5,46.5"
        android:strokeWidth="14.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="40"
                android:endX="54"
                android:endY="76">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.62" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFDDD8FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- crisp specular sheen along the rising arm -->
    <group android:translateY="-2.1">
        <path
            android:pathData="M47,72.5 L68.5,46.5"
            android:strokeColor="#6BFFFFFF"
            android:strokeWidth="4.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>

    <!-- gold star glow -->
    <path
        android:fillColor="#38FBBF24"
        android:pathData="M60.5,34 A11,11 0 1 0 82.5,34 A11,11 0 1 0 60.5,34 Z" />

    <!-- achievement star at the rising apex -->
    <path android:pathData="M71.5,26.5 C72.4,30.6 74.9,33.1 79,34 C74.9,34.9 72.4,37.4 71.5,41.5 C70.6,37.4 68.1,34.9 64,34 C68.1,33.1 70.6,30.6 71.5,26.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="64"
                android:startY="26.5"
                android:endX="79"
                android:endY="41.5">
                <item android:offset="0" android:color="#FFFDE68A" />
                <item android:offset="0.55" android:color="#FFFBBF24" />
                <item android:offset="1" android:color="#FFF59E0B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- star hot core -->
    <path
        android:fillColor="#F2FFFFFF"
        android:pathData="M71.5,31.6 C71.85,33.15 72.5,33.8 74,34 C72.5,34.2 71.85,34.85 71.5,36.4 C71.15,34.85 70.5,34.2 69,34 C70.5,33.8 71.15,33.15 71.5,31.6 Z" />
</vector>
